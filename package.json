{
  "name": "Sticket",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "db:reset": "supabase db reset --local",
    "ios": "react-native run-ios",
    "lint": "eslint . --max-warnings=0",
    "postinstall": "node scripts/patch-react-native-pencil-kit.cjs",
    "start": "react-native start",
    "test": "jest",
    "test:app": "jest --runInBand",
    "test:collector": "npm --prefix collector run test",
    "test:db": "supabase test db --local supabase/tests",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test:app && npm run test:collector",
    "verify:db": "npm run db:reset && npm run test:db",
    "verify:ios": "xcodebuild -workspace ios/Sticket.xcworkspace -scheme Sticket -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build"
  },
  "dependencies": {
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-native/new-app-screen": "0.86.0",
    "@react-navigation/bottom-tabs": "^7.18.5",
    "@react-navigation/native": "^7.3.5",
    "@react-navigation/native-stack": "^7.17.9",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-query": "^5.101.4",
    "base64-arraybuffer": "^1.0.2",
    "lucide-react-native": "^1.23.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-calendars": "^1.1314.0",
    "react-native-device-info": "^15.0.2",
    "react-native-gesture-handler": "3.0.2",
    "react-native-get-random-values": "^2.0.0",
    "react-native-image-crop-picker": "0.51.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-pencil-kit": "1.2.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "react-native-svg": "^15.15.5",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "0.10.2",
    "reanimated-color-picker": "^5.1.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "^0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "jose": "6.2.4",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "supabase": "^2.109.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
